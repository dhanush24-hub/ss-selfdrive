# Supabase — get from supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

SUPABASE_URL=your_supabase_project_url
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Prisma — Supabase PostgreSQL connection
# Replace YOUR_PASSWORD with your Supabase DB password
# IMPORTANT: If password contains @ symbol, encode it as %40
DATABASE_URL=postgresql://postgres.your_project_ref:YOUR_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your_project_ref:YOUR_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# Admin credentials — change these before deploying
ADMIN_USERNAME=Admin@SSDRIVE
ADMIN_PASSWORD=Admin@SSDrive
ADMIN_SESSION_SECRET=your_random_secret_string_here
